<?xml version="1.0" encoding="utf-8"?>
<!--
  Default views for the objects OnetimeSecret emits. Every object keeps its
  full property set (and RawResponse); these views only decide what shows
  up when nothing is piped to Format-* or Select-Object.
-->
<Configuration>
  <ViewDefinitions>

    <View>
      <Name>OnetimeSecret.Connection</Name>
      <ViewSelectedBy>
        <TypeName>OnetimeSecret.Connection</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ServerUri</Label></TableColumnHeader>
          <TableColumnHeader><Label>Username</Label></TableColumnHeader>
          <TableColumnHeader><Label>IsAnonymous</Label></TableColumnHeader>
          <TableColumnHeader><Label>ApiVersion</Label></TableColumnHeader>
          <TableColumnHeader><Label>TimeoutSec</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ServerUri</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Username</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsAnonymous</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ApiVersion</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>TimeoutSec</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>OnetimeSecret.Receipt</Name>
      <ViewSelectedBy>
        <TypeName>OnetimeSecret.Receipt</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ReceiptId</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>SecretId</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>State</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Passphrase</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Expires</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>ShareUrl</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>if ($_.ReceiptId.Length -gt 12) { $_.ReceiptId.Substring(0, 11) + '…' } else { $_.ReceiptId }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if ($_.SecretId.Length -gt 12) { $_.SecretId.Substring(0, 11) + '…' } else { $_.SecretId }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>HasPassphrase</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Expires</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ShareUrl</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>OnetimeSecret.Receipt.List</Name>
      <ViewSelectedBy>
        <TypeName>OnetimeSecret.Receipt</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>ReceiptId</PropertyName></ListItem>
              <ListItem><PropertyName>SecretId</PropertyName></ListItem>
              <ListItem><PropertyName>State</PropertyName></ListItem>
              <ListItem><PropertyName>ShareUrl</PropertyName></ListItem>
              <ListItem><PropertyName>ReceiptUrl</PropertyName></ListItem>
              <ListItem><PropertyName>BurnUrl</PropertyName></ListItem>
              <ListItem><PropertyName>HasPassphrase</PropertyName></ListItem>
              <ListItem><PropertyName>Recipients</PropertyName></ListItem>
              <ListItem><PropertyName>Memo</PropertyName></ListItem>
              <ListItem><PropertyName>Value</PropertyName></ListItem>
              <ListItem><PropertyName>Created</PropertyName></ListItem>
              <ListItem><PropertyName>Expires</PropertyName></ListItem>
              <ListItem><PropertyName>SecretTtl</PropertyName></ListItem>
              <ListItem><PropertyName>IsReceived</PropertyName></ListItem>
              <ListItem><PropertyName>IsBurned</PropertyName></ListItem>
              <ListItem><PropertyName>IsExpired</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <View>
      <Name>OnetimeSecret.Secret</Name>
      <ViewSelectedBy>
        <TypeName>OnetimeSecret.Secret</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>SecretId</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>State</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Passphrase</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Ttl</Label><Width>12</Width></TableColumnHeader>
          <TableColumnHeader><Label>Value</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>if ($_.SecretId.Length -gt 12) { $_.SecretId.Substring(0, 11) + '…' } else { $_.SecretId }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>HasPassphrase</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Ttl</PropertyName></TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if ($_.Value -is [securestring]) { 'System.Security.SecureString' } else { $_.Value }</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>OnetimeSecret.SecretStatus</Name>
      <ViewSelectedBy>
        <TypeName>OnetimeSecret.SecretStatus</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>SecretId</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>State</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Exists</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Passphrase</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Expires</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>if ($_.SecretId.Length -gt 12) { $_.SecretId.Substring(0, 11) + '…' } else { $_.SecretId }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Exists</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>HasPassphrase</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Expires</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>OnetimeSecret.ServiceStatus</Name>
      <ViewSelectedBy>
        <TypeName>OnetimeSecret.ServiceStatus</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ServerUri</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>IsHealthy</Label></TableColumnHeader>
          <TableColumnHeader><Label>Locale</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ServerUri</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsHealthy</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Locale</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

  </ViewDefinitions>
</Configuration>
